# Mẫu biến môi trường. Chép thành .env và điền giá trị thật.
# KHÔNG commit .env. Điều cấm 7: không đưa khóa và mật khẩu vào Git.
# Giá trị thật do người vận hành giữ.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude Code headless (dùng cho các phần khác theo kế hoạch)
ANTHROPIC_API_KEY=

# Chấm CV dùng Google Gemini API miễn phí (Google AI Studio). Lấy khóa tại aistudio.google.com/apikey
GEMINI_API_KEY=
# Model chấm CV. Rỗng thì mặc định gemini-2.0-flash (miễn phí). Đổi nếu muốn model khác.
HR_SCREEN_MODEL=

# Facebook Graph API — PAGE TEST (máy tự đăng + đọc số của chính nó)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Facebook Graph API — PAGE CHÍNH THỨC (SDVICO real), CHỈ để ĐỌC số liệu bài đăng TAY.
# Không nhánh nào đăng bằng token này (page chính thức đăng tay). Token phải là PAGE token của
# page chính thức, có quyền read_insights + pages_read_engagement. Để trống nếu chưa dùng.
FACEBOOK_REAL_PAGE_ID=
FACEBOOK_REAL_PAGE_ACCESS_TOKEN=

# Giao diện duyệt (approval-ui) — các biến này đặt TRÊN VERCEL, ghi ở đây để biết danh sách.
# AUTH_SECRET (29/8, audit bảo mật): khóa ký cookie phiên HMAC v2. Chuỗi ngẫu nhiên dài,
# sinh bằng: openssl rand -hex 32. Đổi giá trị này là mọi phiên đăng nhập cũ hết hạn.
# FACEBOOK_APP_SECRET ở trên còn dùng kiểm chữ ký webhook Facebook (X-Hub-Signature-256).
# Chưa đặt thì webhook vẫn nhận lead nhưng KHÔNG kiểm chữ ký, run_log cảnh báo mỗi lần —
# xin App Secret từ người quản trị app Facebook rồi đặt lên Vercel để siết lại.
APPROVAL_UI_USER=sdvico
APPROVAL_UI_PASSWORD=
AUTH_SECRET=
# Khóa cho cron và máy nội bộ gọi /api (rotate, trigger-video-build...). Đã có trên Vercel.
CRON_SECRET=

# Google, cho Search Console và Analytics, dùng tên miền phụ staging trước
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hộp thư nạp CV, giai đoạn test dùng hộp thư riêng, không phải tuyendung@sdvico.vn.
# Với Gmail: MAIL_IMAP_HOST=imap.gmail.com, MAIL_IMAP_PASSWORD là App Password 16 ký tự,
# không phải mật khẩu tài khoản. Bật xác thực hai bước rồi tạo App Password trong tài khoản Google.
# Trước khi CV thật của ứng viên chảy vào, đổi sang hộp thư do công ty kiểm soát (điều cấm 6).
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_TLS=true
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_MAILBOX=INBOX
# Chỉ nạp CV từ các địa chỉ này, cách nhau bằng dấu phẩy. Rỗng nghĩa là nhận mọi người gửi.
# Giai đoạn test dùng hộp thư cá nhân có lẫn thư thật: đặt chính địa chỉ của bạn để chỉ nạp CV bạn tự gửi,
# tránh ghi nhầm dữ liệu người thật (Nghị định 13, điều cấm 6).
MAIL_INTAKE_ALLOWED_SENDERS=
# Ảnh nhỏ hơn ngưỡng byte này bị bỏ qua khi nạp, để khỏi OCR logo chữ ký
CV_MIN_IMAGE_BYTES=20000

# Storage lưu CV. Bucket riêng tư, mặc định tên cv
CV_BUCKET=cv

# Thời hạn lưu hồ sơ ứng viên theo Nghị định 13/2023, đơn vị tháng
HR_RETENTION_MONTHS=12

# Hạn mức chi phí mô hình trong tuần, đơn vị đồng
MODEL_BUDGET_VND=3000000
