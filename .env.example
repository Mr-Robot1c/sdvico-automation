# Mẫu biến môi trường. Chép thành .env và điền giá trị thật.
# KHÔNG commit .env. Điều cấm 7: không đưa khóa và mật khẩu vào Git.
# Giá trị thật do người vận hành giữ.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude Code headless. Chưa nhánh nào trong repo gọi tới, code hiện chạy bằng Groq.
# Giữ chỗ theo kế hoạch, để rỗng cũng không sao.
ANTHROPIC_API_KEY=

# Chấm CV dùng Groq API miễn phí. Lấy khóa tại console.groq.com/keys
GROQ_API_KEY=
# Model chấm CV. Rỗng thì mặc định llama-3.3-70b-versatile (miễn phí). Đổi nếu muốn model khác.
HR_SCREEN_MODEL=
# Trang Tạo JD trong giao diện cũng dùng GROQ_API_KEY để viết mô tả công việc.
# Trên Vercel, đặt GROQ_API_KEY để AI viết; không có khóa thì trang tạo bản ghép cơ bản.
# Model viết JD, rỗng thì dùng chung HR_SCREEN_MODEL.
HR_JD_MODEL=
# Model soạn câu hỏi và thư mời phỏng vấn, rỗng thì dùng chung HR_SCREEN_MODEL.
HR_INTERVIEW_MODEL=
# Model phân tích JD cho workflow hr-analyze, rỗng thì dùng chung HR_SCREEN_MODEL.
HR_ANALYZE_MODEL=

# Facebook Graph API, giai đoạn dùng Test User và Page nháp trước.
# Cách lấy bốn giá trị dưới: xem docs/facebook-test-setup.md.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Phiên bản Graph API, đổi theo bản Explorer hiển thị nếu cần.
FACEBOOK_GRAPH_VERSION=v21.0
# Trần cứng số tin tuyển dụng đăng lên Page mỗi ngày (kế hoạch Phần 6, hạn mức tự đặt thấp).
HR_FB_MAX_PER_DAY=3
# Chuỗi tự chọn, dùng khi cấu hình webhook nhận bình luận trên developers.facebook.com
# (Callback URL trỏ về /api/webhooks/facebook, điền đúng giá trị này vào ô Verify Token).
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# Trần cứng số câu trả lời bình luận đăng mỗi ngày.
HR_FB_COMMENT_MAX_PER_DAY=20
# Trần cứng số lượt tự react (like) bình luận tích cực mỗi ngày.
HR_FB_REACT_MAX_PER_DAY=50
# Tổng bài đang tồn tại đồng thời trên Page. Vượt giới hạn thì worker tự xóa bài cũ nhất.
HR_FB_MAX_POSTS=20
# Model soạn bài đăng tuyển dụng. Rỗng thì dùng chung model chấm CV (Groq Llama).
HR_POST_MODEL=
# Email liên hệ tuyển dụng hiển thị trong bài đăng. Hộp thư công ty do SDVICO kiểm soát.
HR_CONTACT_EMAIL=sdvicotuyendung@gmail.com

# Unsplash — tự động chèn ảnh vào bài đăng tuyển dụng Facebook.
# Lấy key miễn phí: https://unsplash.com/developers → New Application → Access Key.
# Không có key thì bài đăng vẫn chạy bình thường, chỉ không có ảnh kèm theo.
UNSPLASH_ACCESS_KEY=

# Google, cho Search Console và Analytics, dùng tên miền phụ staging trước
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hộp thư nạp CV, giai đoạn test dùng hộp thư riêng, không phải tuyendung@sdvico.vn.
# Với Gmail: MAIL_IMAP_HOST=imap.gmail.com, MAIL_IMAP_PASSWORD là App Password 16 ký tự,
# không phải mật khẩu tài khoản. Bật xác thực hai bước rồi tạo App Password trong tài khoản Google.
# Trước khi CV thật của ứng viên chảy vào, đổi sang hộp thư do công ty kiểm soát (điều cấm 6).
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_TLS=true
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_MAILBOX=INBOX
# Chỉ nạp CV từ các địa chỉ này, cách nhau bằng dấu phẩy. Rỗng nghĩa là nhận mọi người gửi.
# Giai đoạn test dùng hộp thư cá nhân có lẫn thư thật: đặt chính địa chỉ của bạn để chỉ nạp CV bạn tự gửi,
# tránh ghi nhầm dữ liệu người thật (Nghị định 13, điều cấm 6).
MAIL_INTAKE_ALLOWED_SENDERS=
# Ảnh nhỏ hơn ngưỡng byte này bị bỏ qua khi nạp, để khỏi OCR logo chữ ký
CV_MIN_IMAGE_BYTES=20000

# Storage lưu CV. Bucket riêng tư, mặc định tên cv
CV_BUCKET=cv

# Giao diện duyệt trên Vercel. Bảo vệ dữ liệu ứng viên (điều cấm 6).
#
# Hai chế độ đăng nhập, chọn bằng AUTH_MODE:
#   basic     (mặc định) - HTTP Basic Auth, một mật khẩu dùng chung. Cần APP_USER + APP_PASSWORD.
#   supabase  - magic link qua Supabase Auth. Chỉ email trong bảng hr_users được vào.
#               Cần thêm SUPABASE_ANON_KEY (bên cạnh SUPABASE_URL và SERVICE_ROLE_KEY).
#               Hướng dẫn setup: docs/dang-nhap-supabase-auth.md.
AUTH_MODE=basic
APP_USER=sdvico
APP_PASSWORD=

# Chuỗi bí mật cho các endpoint chạy nền /api/cron/*. GitHub Actions gửi kèm ở
# header Authorization: Bearer. Đặt cùng một giá trị ở Vercel và ở GitHub Secrets.
# Bỏ trống trên Vercel nghĩa là ai biết đường dẫn cũng gọi được, phải đặt.
CRON_SECRET=

# Gửi thư mời phỏng vấn và thư kết quả. Hiện chỉ chạy với Gmail (nodemailer service gmail),
# nên SMTP_PASS là App Password 16 ký tự, không phải mật khẩu tài khoản.
# Bỏ trống SMTP_USER và SMTP_PASS thì hệ thống dùng lại MAIL_IMAP_USER và MAIL_IMAP_PASSWORD.
SMTP_USER=
SMTP_PASS=
# Tên người gửi hiện trong hộp thư ứng viên, ví dụ: SDVICO Tuyển dụng <tuyendung@sdvico.vn>
SMTP_FROM=

# LinkedIn Company Page. Chưa có hai giá trị đầu thì phần đăng LinkedIn nằm im,
# bài vẫn soạn và vẫn duyệt được, chỉ không tự đăng.
# Token cần quyền w_organization_social của Community Management API.
LINKEDIN_ACCESS_TOKEN=
# Dạng urn:li:organization:XXXXXX
LINKEDIN_ORG_URN=
# Phiên bản API dạng YYYYMM, rỗng thì mặc định 202601.
LINKEDIN_VERSION=

# Thời hạn lưu hồ sơ ứng viên theo Nghị định 13/2023, đơn vị tháng
HR_RETENTION_MONTHS=12

# Hạn mức chi phí mô hình trong tuần, đơn vị đồng
MODEL_BUDGET_VND=3000000

# Tìm CV chủ động (TopCV và tương tự) — TẮT MẶC ĐỊNH, cần Phòng Nhân sự/pháp lý xác nhận
# trước khi bật (xem trang Cài đặt > Nguồn CV chủ động). Rỗng thì packages/hr/src/sourcing-cv/run.mjs
# dừng ngay, không chạm trình duyệt.
# Thư mục hồ sơ trình duyệt (giữ phiên đăng nhập) cho tài khoản nhà tuyển dụng trả phí.
TOPCV_ACCOUNT_PROFILE_DIR=
# JSON cấu hình luồng: {"loginUrl":"...","searchUrl":"...","resultSelector":"...","detailSelector":"...","maxPerRun":5}
# Bộ chọn (selector) phải điền theo giao diện thật của trang lúc dùng, không đoán trước.
HR_CV_SOURCE_CONFIG=
